# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor 서명 키 (앱 배포용 keystore는 절대 커밋 금지)
*.keystore
!android/app/debug.keystore

# Firebase 설정 (API 키 포함)
ios/App/App/GoogleService-Info.plist
android/app/google-services.json

# APNs 인증 키 (iOS 푸시) — 절대 커밋 금지
*.p8
AuthKey_*.p8

# Apple 서명 / 프로비저닝 (개인 인증서)
*.mobileprovision
*.cer
*.p12
*.certSigningRequest

# 서버 service-account 키 (혹시 클라 폴더에 흘러들어올 경우 대비)
firebase-service-account.json
service-account*.json
google-application-credentials.json

# 개인 .env (로컬에서만 쓰는 값 — 누군가 만들 경우 대비)
.env.local
.env.*.local

# Claude Code 로컬 설정 (사용자별 권한 목록)
.claude/settings.local.json
