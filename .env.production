# .env.production - 프로덕션 환경
# 운영 서버 배포시 사용 (npm run build)

# 현재 환경 식별자
VITE_ENV_NAME=production

# WebSocket URL (nginx 프록시 경유)
VITE_WS_URL=https://yogurtte.com/api/ws

# MSA 서비스 URL (nginx 리버스 프록시 경유)
VITE_AUTH_BASE_URL=https://yogurtte.com/auth
VITE_CONTENT_BASE_URL=https://yogurtte.com/content
VITE_USER_BASE_URL=https://yogurtte.com
VITE_CHAT_BASE_URL=https://yogurtte.com/chat
