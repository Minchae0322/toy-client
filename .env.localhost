# .env.localhost - 로컬 백엔드 개발 환경
# npm run dev 실행 시 사용됨

# 현재 환경 식별자
VITE_ENV_NAME=localhost

# WebSocket URL
VITE_WS_URL=http://localhost:8084/api/ws

# MSA 서비스 URL (로컬 백엔드)
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_CONTENT_BASE_URL=http://localhost:8082
VITE_USER_BASE_URL=http://localhost:8083
VITE_CHAT_BASE_URL=http://localhost:8084

# Proxy 설정용 (vite dev server에서 사용)
VITE_PROXY_AUTH_TARGET=http://localhost:8081
VITE_PROXY_CONTENT_TARGET=http://localhost:8082
VITE_PROXY_USER_TARGET=http://localhost:8083
VITE_PROXY_CHAT_TARGET=http://localhost:8084
