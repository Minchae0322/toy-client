# .env - 기본 환경 변수 템플릿
# 이 파일은 .env.local이 없을 때 기본값으로 사용됩니다
# 실제 개발시에는 .env.local을 생성하여 사용하세요

# 현재 환경 식별자 (local, development, production)
VITE_ENV_NAME=local

# WebSocket URL
VITE_WS_URL=http://localhost:8084/api/ws

# MSA 서비스 URL
VITE_AUTH_BASE_URL=http://localhost:8081/api
VITE_CONTENT_BASE_URL=http://localhost:8082
VITE_USER_BASE_URL=http://localhost:8083
VITE_CHAT_BASE_URL=http://localhost:8084

# Proxy 설정용 (vite dev server에서 사용)
VITE_PROXY_AUTH_TARGET=http://localhost:8081
VITE_PROXY_CONTENT_TARGET=http://localhost:8082
VITE_PROXY_USER_TARGET=http://localhost:8083
VITE_PROXY_CHAT_TARGET=http://localhost:8084

# OAuth (네이티브 빌드용)
VITE_GOOGLE_WEB_CLIENT_ID=4259829940-5fchek1qftvv1i3nhqbjh4lc54pnfek0.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=4259829940-350nolglb7ai5188k61qfvua1mrralcj.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.jmcabc0322.yogurt.service
