# .env.development (개발 환경)
# MSA 서비스별 API 엔드포인트
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_CONTENT_BASE_URL=http://localhost:8082
VITE_USER_BASE_URL=http://localhost:8083
VITE_CHAT_BASE_URL=http://localhost:8084

# WebSocket URL (프록시 사용)
VITE_WS_URL=/api/ws

# 앱 설정
VITE_APP_ENV=development
VITE_APP_TITLE=ToyChat Dev
VITE_DEBUG_MODE=true
# Mock API 사용 여부 (백엔드가 준비되지 않은 경우)
VITE_USE_MOCK_API=false

# .env.production (운영 환경)
# MSA 서비스별 API 엔드포인트
VITE_AUTH_BASE_URL=https://auth.yourapp.com
VITE_CONTENT_BASE_URL=https://content.yourapp.com
VITE_USER_BASE_URL=https://user.yourapp.com
VITE_CHAT_BASE_URL=https://chat.yourapp.com

# WebSocket URL (채팅 서비스)
VITE_WS_URL=https://chat.yourapp.com/api/ws

# 앱 설정
VITE_APP_ENV=production
VITE_APP_TITLE=ToyChat
VITE_DEBUG_MODE=false

# .env.local (로컬 개발자별 설정 - Git 무시됨)
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_CONTENT_BASE_URL=http://localhost:8082
VITE_USER_BASE_URL=http://localhost:8083
VITE_CHAT_BASE_URL=http://localhost:8084
# 로컬 개발자별 설정
VITE_WS_URL=/api/ws
VITE_DEBUG_MODE=true