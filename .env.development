# .env.development - 개발 서버 환경
# 원격 개발 서버에 연결할 때 사용 (npm run dev:remote)

# 현재 환경 식별자
VITE_ENV_NAME=development

# WebSocket URL
VITE_WS_URL=http://54.180.89.70:8084/api/ws

# MSA 서비스 URL (개발 서버 - 포트 직접 접근)
VITE_AUTH_BASE_URL=http://54.180.89.70/auth
VITE_CONTENT_BASE_URL=http://54.180.89.70/content
VITE_USER_BASE_URL=http://54.180.89.70
VITE_CHAT_BASE_URL=http://54.180.89.70/chat

# Proxy 설정용 (vite dev server에서 사용)
VITE_PROXY_AUTH_TARGET=http://54.180.89.70/auth
VITE_PROXY_CONTENT_TARGET=http://54.180.89.70/content
VITE_PROXY_USER_TARGET=http://54.180.89.70
VITE_PROXY_CHAT_TARGET=http://54.180.89.70/chat
