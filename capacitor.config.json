{
  "appId": "com.jmcabc0322.yogurt",
  "appName": "요거뜨",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "ios": {
    "backgroundColor": "#ffffff"
  },
  "android": {
    "backgroundColor": "#ffffff"
  },
  "server": {
    "hostname": "app.yogurtte.com",
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "directUpdate": false,
      "resetWhenUpdate": false,
      "defaultChannel": "production"
    }
  }
}
