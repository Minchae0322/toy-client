{
  "name": "client",
  "private": true,
  "version": "1.1.17",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:localhost": "vite --mode localhost",
    "dev:mobile": "vite --mode development --host",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "preview:dev": "vite preview --mode development",
    "deploy": "bash deploy.sh",
    "cap:sync": "npm run build:prod && npx cap sync",
    "cap:android": "npm run build:prod && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build:prod && npx cap sync ios && npx cap open ios",
    "ota:bump": "npm version patch --no-git-tag-version",
    "ota:deploy": "npm run ota:bump && npm run build:prod && npx @capgo/cli@latest bundle upload --channel production"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^7.5.0",
    "@capacitor/android": "^7.6.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.2",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@capgo/capacitor-updater": "^7.45.10",
    "@heroicons/vue": "^2.2.0",
    "@stomp/stompjs": "^7.1.1",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "lucide-vue-next": "^0.513.0",
    "pinia": "^3.0.2",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5"
  }
}
